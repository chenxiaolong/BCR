    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_action_ignore_desc">해당 통화를 완전히 무시합니다. 녹음이 진행되지 않으며 통화 중 수동으로 녹음을 시작할 수 없습니다.</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Action: " prefix for visual consistency. -->
    <string name="record_rule_action_save_summary">동작: 녹음 저장</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Action: " prefix for visual consistency. -->
    <string name="record_rule_action_discard_summary">동작: 녹음 삭제</string>
