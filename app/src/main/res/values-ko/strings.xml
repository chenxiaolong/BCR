<resources>
    <string name="app_name_full">Basic Call Recorder</string>

    <!-- Preference headers -->
    <string name="pref_header_general">일반</string>
    <string name="pref_header_about">정보</string>
    <string name="pref_header_debug">디버그</string>

    <!-- General preferences -->
    <string name="pref_call_recording_name">통화 녹음</string>
    <string name="pref_call_recording_desc">수신 및 발신 통화를 녹음합니다. 백그라운드 녹음에는 마이크 및 알림 권한이 필요합니다.</string>

    <string name="pref_record_rules_name">자동 녹음 규칙</string>
    <string name="pref_record_rules_desc">어떤 통화를 자동으로 녹음할지 설정합니다.</string>

    <string name="pref_output_dir_name">저장 디렉터리</string>
    <string name="pref_output_dir_desc">녹음 파일을 저장할 디렉터리를 선택하세요. 길게 누르면 파일 관리자에서 열립니다.</string>

    <string name="pref_output_format_name">출력 형식</string>
    <string name="pref_output_format_desc">녹음 파일의 인코딩 형식을 선택하세요.</string>

    <string name="pref_min_duration_name">최소 녹음 길이</string>
    <plurals name="pref_min_duration_desc">
        <item quantity="other">%d초 이상인 녹음만 보관합니다.</item>
    </plurals>
    <string name="pref_min_duration_desc_zero">모든 길이의 녹음을 보관합니다.</string>

    <string name="pref_write_metadata_name">메타데이터 파일 생성</string>
    <string name="pref_write_metadata_desc">오디오 파일과 함께 통화 세부 정보가 포함된 JSON 파일을 생성합니다.</string>

    <string name="pref_record_telecom_apps_name">통신 시스템 통합 앱 녹음</string>
    <string name="pref_record_telecom_apps_desc">Android 통신 프레임워크를 사용하는 서드파티 앱의 통화를 녹음합니다. 이러한 통화 녹음은 오디오가 불완전하거나 누락되는 등 정상적이지 않을 수 있습니다.</string>

    <string name="pref_record_dialing_state_name">연결 전 녹음 시작</string>
    <string name="pref_record_dialing_state_desc">발신 통화의 경우 통화가 연결될 때까지 기다리지 않고 다이얼이 시작되는 즉시 녹음을 시작합니다.</string>

    <string name="pref_notification_open_dir_name">알림에서 디렉터리 열기</string>
    <string name="pref_notification_open_dir_desc">녹음 완료 알림을 탭했을 때 녹음 파일 대신 저장 디렉터리를 엽니다.</string>

    <string name="pref_show_launcher_icon_name">런처 아이콘 표시</string>
    <string name="pref_show_launcher_icon_desc">런처 아이콘을 숨긴 경우 다이얼패드에 <b>*#*#BCR#*#*</b>를 입력하여 앱을 열 수 있습니다.</string>

    <!-- About "preference" -->
    <string name="pref_version_name">버전</string>

    <!-- Debug preferences -->
    <string name="pref_force_direct_boot_name">다이렉트 부트 모드 강제 적용</string>
    <string name="pref_force_direct_boot_desc">테스트를 위해 기기가 첫 잠금 해제 전인 상태처럼 시뮬레이션합니다.</string>

    <string name="pref_migrate_direct_boot_name">다이렉트 부트 녹음 파일 이전</string>
    <string name="pref_migrate_direct_boot_desc">첫 잠금 해제 전에 저장된 녹음 파일을 이전합니다. 보통 첫 잠금 해제 후 자동으로 수행됩니다.</string>

    <string name="pref_save_logs_name">로그 저장</string>
    <string name="pref_save_logs_desc">logcat 로그를 파일로 저장합니다.</string>

    <!-- Pick contact group activity -->
    <string name="pick_contact_group_title">연락처 그룹 선택</string>
    <string name="pick_contact_group_local_group">로컬 그룹</string>

    <!-- Title of the preference category holding the "Add new rule" option and the list of record rules. -->
    <string name="pref_header_rules">규칙</string>
    <!-- Message shown above the record rules list that indicates what rules do and how to interact with the list UI. -->
    <string name="record_rules_info">규칙은 일치하는 통화에 대해 수행할 동작을 결정합니다. 목록의 위에서 아래 순서로 처리되며 일치 항목을 찾으면 중단됩니다. 길게 눌러 순서를 변경하거나 스와이프하여 삭제할 수 있습니다.</string>
    <!-- Title of preference option for adding a new record rule. -->
    <string name="pref_add_new_rule_name">새 규칙 추가</string>
    <!-- Description of preference option for adding a new record rule. -->
    <string name="pref_add_new_rule_desc">일치하는 통화를 처리할 새 규칙을 추가합니다.</string>
    <!-- Numeric title for every custom rule (excluding the default rule). The placeholder value (Arabic numerals) is a number starting at 1. -->
    <string name="record_rules_list_custom_name">규칙 %d</string>
    <!-- Title for the default/fallback rule at the bottom of the list. -->
    <string name="record_rules_list_default_name">기본 규칙</string>
    <!-- Accessibility option to move a rule up by one spot in the list. -->
    <string name="record_rules_list_action_move_up">규칙 위로 이동</string>
    <!-- Accessibility option to move a rule down by one spot in the list. -->
    <string name="record_rules_list_action_move_down">규칙 아래로 이동</string>
    <!-- Accessibility option to remove a rule. -->
    <string name="record_rules_list_action_remove">규칙 제거</string>

    <!-- Title of the preference category for the conditions that a record rule must match. -->
    <string name="pref_header_rule_conditions">규칙 조건</string>
