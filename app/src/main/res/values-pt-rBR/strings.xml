<resources>
    <string name="app_name_full">Basic Call Recorder</string>

    <!-- Preference headers -->
    <string name="pref_header_general">Geral</string>
    <string name="pref_header_about">Sobre</string>
    <string name="pref_header_debug">Depuração</string>

    <!-- General preferences -->
    <string name="pref_call_recording_name">Gravação de chamadas</string>
    <string name="pref_call_recording_desc">Grave chamadas recebidas e efetuadas. As permissões de microfone e de notificações são necessárias para gravar em segundo plano.</string>

    <string name="pref_record_rules_name">Regras de gravação automática</string>
    <string name="pref_record_rules_desc">Configure quais chamadas devem ser gravadas automaticamente.</string>

    <string name="pref_output_dir_name">Diretório de saída</string>
    <string name="pref_output_dir_desc">Escolha um diretório para armazenar as gravações. Pressione e segure para abrir no gerenciador de arquivos.</string>

    <string name="pref_output_format_name">Formato de saída</string>
    <string name="pref_output_format_desc">Selecione um formato de codificação para as gravações.</string>

    <string name="pref_min_duration_name">Duração mínima da gravação</string>
    <plurals name="pref_min_duration_desc">
        <item quantity="one">Manter gravações com pelo menos %d segundo de duração.</item>
        <item quantity="other">Manter gravações com pelo menos %d segundos de duração.</item>
    </plurals>
    <string name="pref_min_duration_desc_zero">Manter gravações de qualquer duração.</string>

    <string name="pref_write_metadata_name">Gravar arquivo de metadados</string>
    <string name="pref_write_metadata_desc">Criar um arquivo JSON com detalhes sobre a chamada ao lado do arquivo de áudio.</string>

    <string name="pref_record_telecom_apps_name">Gravar chamadas integradas à telefonia</string>
    <string name="pref_record_telecom_apps_desc">Grave chamadas de apps de terceiros que usam o framework de telefonia do Android. As gravações dessas chamadas provavelmente conterão áudio incompleto, ausente ou inutilizável de outra forma.</string>

    <string name="pref_record_dialing_state_name">Gravar chamadas antes da conexão</string>
    <string name="pref_record_dialing_state_desc">Para chamadas efetuadas, começar a gravar assim que a discagem iniciar, em vez de esperar até a chamada se conectar.</string>

    <string name="pref_notification_open_dir_name">Abrir diretório pela notificação</string>
    <string name="pref_notification_open_dir_desc">Abrir o diretório de saída em vez do arquivo de gravação ao tocar na notificação de gravação concluída.</string>

    <string name="pref_show_launcher_icon_name">Mostrar ícone na tela inicial</string>
    <string name="pref_show_launcher_icon_desc">Quando o ícone estiver oculto, disque <b>*#*#BCR#*#*</b> para abrir o app.</string>

    <!-- About "preference" -->
    <string name="pref_version_name">Versão</string>

    <!-- Debug preferences -->
    <string name="pref_force_direct_boot_name">Forçar modo de inicialização direta</string>
    <string name="pref_force_direct_boot_desc">Fingir que o dispositivo está no estado anterior ao primeiro desbloqueio, para fins de teste.</string>

    <string name="pref_migrate_direct_boot_name">Migrar gravações da inicialização direta</string>
    <string name="pref_migrate_direct_boot_desc">Migrar gravações feitas antes do primeiro desbloqueio. Isso normalmente acontece automaticamente após o primeiro desbloqueio.</string>

    <string name="pref_save_logs_name">Salvar logs</string>
    <string name="pref_save_logs_desc">Salvar os logs do logcat em um arquivo.</string>

    <!-- Pick contact group activity -->
    <string name="pick_contact_group_title">Escolher grupo de contatos</string>
    <string name="pick_contact_group_local_group">Grupo local</string>

    <!-- Title of the preference category holding the "Add new rule" option and the list of record rules. -->
    <string name="pref_header_rules">Regras</string>
    <!-- Message shown above the record rules list that indicates what rules do and how to interact with the list UI. -->
    <string name="record_rules_info">As regras determinam qual ação tomar para uma chamada correspondente. Elas são processadas de cima para baixo até que uma correspondência seja encontrada. Toque e segure para reordenar as regras ou deslize para excluí-las.</string>
    <!-- Title of preference option for adding a new record rule. -->
    <string name="pref_add_new_rule_name">Adicionar nova regra</string>
    <!-- Description of preference option for adding a new record rule. -->
    <string name="pref_add_new_rule_desc">Adicione uma nova regra para determinar a ação a tomar para uma chamada correspondente.</string>
    <!-- Numeric title for every custom rule (excluding the default rule). The placeholder value (Arabic numerals) is a number starting at 1. -->
    <string name="record_rules_list_custom_name">Regra %d</string>
    <!-- Title for the default/fallback rule at the bottom of the list. -->
    <string name="record_rules_list_default_name">Regra padrão</string>
    <!-- Accessibility option to move a rule up by one spot in the list. -->
    <string name="record_rules_list_action_move_up">Mover regra para cima</string>
    <!-- Accessibility option to move a rule down by one spot in the list. -->
    <string name="record_rules_list_action_move_down">Mover regra para baixo</string>
    <!-- Accessibility option to remove a rule. -->
    <string name="record_rules_list_action_remove">Remover regra</string>

    <!-- Title of the preference category for the conditions that a record rule must match. -->
    <string name="pref_header_rule_conditions">Condições da regra</string>
    <!-- Title of the preference category for the actions to take when a record rule matches. -->
    <string name="pref_header_rule_actions">Ações da regra</string>

    <!-- Title of the record rule editor section for configuring the call number to match. -->
    <string name="record_rule_number_title">Número da chamada</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_number_any_item">Qualquer número</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_number_unknown_item">Números desconhecidos</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_number_contact_item">Contato</string>
    <!-- Text for the UI item to select this element in the rule editor. This represents contact group rules as a category, not a specific contact group. -->
    <string name="record_rule_number_contact_group_item">Grupo de contatos</string>
    <!-- Summary shown in the record rules list descriptions. This should include a "Match: " prefix for visual consistency. -->
    <string name="record_rule_number_unknown_summary">Correspondência: Números desconhecidos</string>
    <!-- Summary shown in the record rules list descriptions. This intentionally has no "Match: " prefix because it already has another prefix. When the contacts permission is denied, this will display an internal contact ID instead of the contact name. -->
    <string name="record_rule_number_contact_summary">Contato: %s</string>
    <!-- Summary shown in the record rules list descriptions. This intentionally has no "Match: " prefix because it already has another prefix. This variant is only used when the contacts permission is denied and only the group ID is available (not the group name or account). -->
    <string name="record_rule_number_contact_group_unknown_summary">Grupo de contatos: %s</string>
    <!-- Summary shown in the record rules list descriptions. This intentionally has no "Match: " prefix because it already has another prefix. -->
    <string name="record_rule_number_contact_group_with_account_summary">Grupo de contatos: %1$s (%2$s)</string>

    <!-- Title of the record rule editor section for configuring the type of call to match. -->
    <string name="record_rule_type_title">Tipo de chamada</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_type_any_item">Qualquer</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_type_incoming_item">Chamada recebida</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_type_outgoing_item">Chamada efetuada</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_type_conference_item">Chamada em conferência</string>
    <!-- Summary shown in the record rules list descriptions. This should include a "Type: " prefix for visual consistency. -->
    <string name="record_rule_type_incoming_summary">Tipo: Chamada recebida</string>
    <!-- Summary shown in the record rules list descriptions. This should include a "Type: " prefix for visual consistency. -->
    <string name="record_rule_type_outgoing_summary">Tipo: Chamada efetuada</string>
    <!-- Summary shown in the record rules list descriptions. This should include a "Type: " prefix for visual consistency. -->
    <string name="record_rule_type_conference_summary">Tipo: Chamada em conferência</string>

    <!-- Title of the record rule editor section for configuring which SIM slot to match. -->
    <string name="record_rule_sim_title">Slot do SIM</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_sim_any_item">Qualquer</string>
    <!-- Text for the UI item to select a specific SIM slot in the rule editor. The placeholder value (Arabic numerals) is a number starting at 1. -->
    <string name="record_rule_sim_specific_item">SIM %d</string>
    <!-- Summary shown in the record rules list descriptions. This should have a prefix, like other summary lines, for visual consistency. The placeholder value (Arabic numerals) is a number starting at 1. -->
    <string name="record_rule_sim_specific_summary">Slot do SIM: %d</string>

    <!-- Title of the record rule editor section to configure the action to take when all conditions match. -->
    <string name="record_rule_action_title">Ação</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_action_save_item">Salvar gravação</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_action_discard_item">Descartar gravação</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_action_ignore_item">Ignorar chamada</string>
    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_action_save_desc">Salvar a gravação. A gravação pode ser marcada para exclusão ao final da chamada através da notificação exibida durante a chamada.</string>
    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_action_discard_desc">Descartar a gravação ao final da chamada. A gravação pode ser preservada através da notificação exibida durante a chamada.</string>
    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_action_ignore_desc">Ignorar completamente a chamada. A chamada não será gravada e não é possível iniciar a gravação durante a chamada.</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Action: " prefix for visual consistency. -->
    <string name="record_rule_action_save_summary">Ação: Salvar gravação</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Action: " prefix for visual consistency. -->
    <string name="record_rule_action_discard_summary">Ação: Descartar gravação</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Action: " prefix for visual consistency. -->
    <string name="record_rule_action_ignore_summary">Ação: Ignorar chamada</string>

    <!-- Title of the record rule editor section to configure whether the recording begins immediately or starts in the paused state. -->
    <string name="record_rule_initial_state_title">Estado inicial</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_initial_state_recording_item">Gravar imediatamente</string>
    <!-- Text for the UI item to select this element in the rule editor. -->
    <string name="record_rule_initial_state_paused_item">Pausado até retomar manualmente</string>
    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_initial_state_recording_desc">A gravação começará imediatamente e toda a chamada será gravada, a menos que a opção \"Pausar\" seja selecionada manualmente na notificação.</string>
    <!-- Description shown for this action in the rule editor. The text can be as verbose as necessary. -->
    <string name="record_rule_initial_state_paused_desc">O áudio não será gravado até que a opção \"Retomar\" seja selecionada manualmente na notificação.</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Initial state: " prefix for visual consistency. -->
    <string name="record_rule_initial_state_recording_summary">Estado inicial: Gravar imediatamente</string>
    <!-- Summary shown in the record rules list descriptions. This should include an "Initial state: " prefix for visual consistency. -->
    <string name="record_rule_initial_state_paused_summary">Estado inicial: Pausado até retomar manualmente</string>

